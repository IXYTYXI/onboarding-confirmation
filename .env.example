# 复制为 .env 后按需修改：
#   cp .env.example .env
#
# 说明：
# - .env 已被 .gitignore，不会提交到仓库
# - docker compose 会自动读取同目录 .env，用于变量替换
# - 部署机上的 .env 会被 deploy/ci-deploy.sh 保留（不会被 git clean / rsync 清掉）
# - 下面默认值与当前正式多维表 / docker-compose.yml / local-bridge.mjs 一致
# - 本地改代码后若要能直接部署，请至少确认 HOST/PORT/BASE_TOKEN/TABLE_ID/FIELD_ID

# ---------- 服务监听（容器部署必须用 0.0.0.0）----------
HOST=0.0.0.0
PORT=8787

# 静态资源根目录（一般不用改；容器内默认是代码目录）
# STATIC_ROOT=/app

# ---------- 多维表格 ----------
# 0=真实写入；1=干跑（不落库，适合联调）
DRY_RUN=0
BASE_TOKEN=T533b6qQma5Y6gs1laCcTIL2ngf
TABLE_ID=tblVjMV66M1JDAF3
# 回写「回传信息」字段
FIELD_ID=fldsUS8hLE
# 用业务 ID 查记录时，按顺序尝试的字段名（逗号分隔）
LOOKUP_FIELDS=记录 ID,投递ID,ID

# ---------- 飞书异常提醒 ----------
# 1/省略=开启；0=关闭
ALERT_ENABLED=1
ALERT_USER_ID=ou_7101a2af89955673362022fa3f60c8be

# ---------- 飞书 CLI（容器内一般已全局安装 lark-cli，通常不用设）----------
# LARK_CLI_BIN=/usr/local/bin/lark-cli
# LARK_CLI_SCRIPT=
